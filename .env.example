# Copy to .env.local for a local run against real data. Every VITE_ value is
# compiled into the app and is public: only URLs and the anon key go here.
# With none of these set, `npm run dev` runs on sample data.

# Mole V3 — for sign-in and events (Supabase → Settings → API in Mole V3)
VITE_MOLE_SUPABASE_URL=https://czuquiqpsjwpiqmcllbd.supabase.co
VITE_MOLE_SUPABASE_ANON_KEY=

# This product's own backend
VITE_ANALYTICS_API_URL=https://<mole-analytics-project-ref>.supabase.co/functions/v1/api

# Force sample data even when the three above are set
# VITE_SAMPLE_DATA=true
